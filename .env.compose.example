# Copy to .env for Docker Compose. Never commit the populated .env file.
# Generate a URL-safe database password with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Generate with: openssl rand -base64 32
SCOPELEDGER_MASTER_KEY=
# Set to the OLD key only while rotating SCOPELEDGER_MASTER_KEY. Stored secrets
# still encrypted under it stay readable; new writes use the current key.
# Remove it once rotation is complete.
SCOPELEDGER_PREVIOUS_MASTER_KEY=

# Loopback HTTP is supported for one-machine use. Use an HTTPS origin before binding to a LAN address.
APP_URL=http://127.0.0.1:3000
SCOPELEDGER_BIND_ADDRESS=127.0.0.1
APP_PORT=3000

DATABASE_POOL_SIZE=10
DATABASE_STARTUP_TIMEOUT_MS=90000
# Optional override for an external PostgreSQL server. Leave blank to use the Compose database.
DATABASE_URL=

# The Anthropic API is the default and requires a key.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
AI_TIMEOUT_MS=90000
AI_MAX_ATTEMPTS=2
ANALYSIS_JOB_MAX_ATTEMPTS=3

# Local-only inference. Set AI_PROVIDER=ollama to keep analysis on your own hardware.
# For a LAN Ollama server, use its private IP and protect the network boundary.
# OLLAMA_NUM_CTX must exceed the combined SOW, boundary map, and message length or Ollama
# silently discards the oldest tokens. Raising it increases VRAM use.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:12b-it-qat
OLLAMA_NUM_CTX=8192

# Optional fallback provider. Leave blank to fail conservatively to human review.
AI_FALLBACK_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

ALLOW_PRIVATE_INTEGRATION_HOSTS=false
ALLOW_INSECURE_IMAP=false
