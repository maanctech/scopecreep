{
  "name": "scope-creep-recovery-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "tsx scripts/validate-config.ts && next start",
    "test": "vitest run",
    "seed": "node scripts/seed-demo.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:wait": "tsx scripts/wait-for-database.ts",
    "db:import-json": "tsx scripts/import-json.ts",
    "db:seed-demo": "npm run seed && tsx scripts/import-json.ts --file=data/demo-store.json --apply",
    "db:create-admin": "tsx scripts/create-admin.ts",
    "db:create-user": "tsx scripts/create-user.ts",
    "db:password-reset": "tsx scripts/generate-password-reset.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "config:check": "tsx scripts/validate-config.ts",
    "constants:generate": "tsx scripts/generate-constants.ts",
    "rls:check": "tsx scripts/check-rls.ts",
    "ai:check": "tsx scripts/check-ai.ts",
    "ollama:check": "tsx scripts/check-ollama.ts",
    "lint": "eslint .",
    "format": "eslint . --fix",
    "format:check": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@node-rs/argon2": "^2.0.2",
    "csv-parse": "^6.1.0",
    "imapflow": "^1.4.9",
    "lucide-react": "^0.468.0",
    "mailparser": "^3.9.14",
    "mammoth": "^1.12.0",
    "next": "^16.2.11",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "0.35.0",
    "tsx": "^4.23.1",
    "unpdf": "^1.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "postcss": "8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.25"
  }
}
