{
  "name": "scope-creep-recovery-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -H 127.0.0.1 -p 3000",
    "build": "next build --webpack",
    "start": "tsx scripts/validate-config.ts && next start",
    "test": "vitest run",
    "seed": "node scripts/seed-demo.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:wait": "tsx scripts/wait-for-database.ts",
    "db:import-json": "tsx scripts/import-json.ts",
    "db:seed-demo": "npm run seed && tsx scripts/import-json.ts --file=data/demo-store.json --apply",
    "db:create-admin": "tsx scripts/create-admin.ts",
    "db:create-user": "tsx scripts/create-user.ts",
    "db:password-reset": "tsx scripts/generate-password-reset.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "config:check": "tsx scripts/validate-config.ts",
    "ollama:check": "tsx scripts/check-ollama.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@supabase/supabase-js": "^2.45.4",
    "csv-parse": "^6.1.0",
    "imapflow": "^1.4.9",
    "lucide-react": "^0.468.0",
    "mailparser": "^3.9.14",
    "mammoth": "^1.12.0",
    "next": "^16.2.11",
    "pg": "^8.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.35.0",
    "tsx": "^4.23.1",
    "unpdf": "^1.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "8.5.10",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss",
      "sharp": "$sharp"
    }
  }
}
