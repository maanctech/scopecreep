# Required commercial storage. Example for local PostgreSQL:
DATABASE_URL=postgresql://scopeledger:change-me@127.0.0.1:5432/scopeledger
DATABASE_POOL_SIZE=10
DATABASE_SSL=disable
DATABASE_STARTUP_TIMEOUT_MS=90000

# Private local contract originals. Keep this on backed-up, access-controlled storage.
SCOPELEDGER_DOCUMENT_DIR=./data/documents
SCOPELEDGER_BACKUP_DIR=./backups
# Optional when PostgreSQL client tools are not on PATH.
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore

# Required for production startup and before saving any integration credential.
# Generate with: openssl rand -base64 32
SCOPELEDGER_MASTER_KEY=
# Set to the OLD key only while rotating SCOPELEDGER_MASTER_KEY. Stored secrets
# still encrypted under it stay readable; new writes use the current key.
# Remove it once rotation is complete.
SCOPELEDGER_PREVIOUS_MASTER_KEY=
ALLOW_PRIVATE_INTEGRATION_HOSTS=false
ALLOW_INSECURE_IMAP=false

# Public origin used for secure cookies and administrator-generated reset links.
# Non-loopback production origins must use HTTPS.
APP_URL=http://127.0.0.1:3000
# Number of reverse proxies that overwrite/append X-Forwarded-For. Keep 0 for direct local use.
TRUSTED_PROXY_HOPS=0

# First owner account. Used only by npm run db:create-admin.
SCOPELEDGER_ORGANIZATION_NAME=
SCOPELEDGER_ADMIN_NAME=
SCOPELEDGER_ADMIN_EMAIL=
SCOPELEDGER_ADMIN_PASSWORD=

# Additional user provisioning. Used only by npm run db:create-user.
SCOPELEDGER_ORGANIZATION_ID=
SCOPELEDGER_USER_NAME=
SCOPELEDGER_USER_EMAIL=
SCOPELEDGER_USER_PASSWORD=
SCOPELEDGER_USER_ROLE=Read Only

# Explicit legacy/demo escape hatch. PostgreSQL is the default when omitted.
# SCOPELEDGER_STORAGE=json

# AI configuration. Ollama is the default; no cloud key is required.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:12b-it-qat
OLLAMA_NUM_CTX=32768
AI_TIMEOUT_MS=90000
AI_MAX_ATTEMPTS=2
# Total executions allowed for one persisted analysis job, including retries.
ANALYSIS_JOB_MAX_ATTEMPTS=3
# Running jobs older than these thresholds can be recovered as failed.
ANALYSIS_STALE_MINUTES=30
INGESTION_STALE_MINUTES=30
AUTOMATION_POLL_SECONDS=15
AUTOMATION_LEASE_MINUTES=30

# Optional fallback provider. Leave blank to fail conservatively to human review.
AI_FALLBACK_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
